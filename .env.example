# @BotFather se mila token
BOT_TOKEN=123456789:ABCdefYourTokenHere
# Aapki Telegram user ID(s), comma se alag (bot me /id bhejkar dekhein) — sirf saved-sessions manager ke liye
OWNER_IDS=
# SQLite database file ka naam
DB_PATH=bot.db

# ---- Session String Generator / Manager ----
# OPTIONAL: https://my.telegram.org se. Set ho to /session me "Bot ka default API" button aata hai,
# warna har user apna API ID/HASH khud daalta hai. Session string environment me daalne ki zarurat NAHI.
API_ID=
API_HASH=
# Session strings ko encrypt karne ki key. Khaali chhodenge to pehli baar secret.key file ban jayegi.
SESSION_SECRET=
