# @BotFather se mila token
BOT_TOKEN=123456789:ABCdefYourTokenHere
# Aapki Telegram user ID(s), comma se alag — group super-admin + Session Manager sirf inhe dikhega (ZAROORI)
OWNER_IDS=
# SQLite database file ka naam
DB_PATH=bot.db

# ---- Session Manager (Telethon) ----
# https://my.telegram.org -> API development tools se milega
API_ID=
API_HASH=
# Session strings ko encrypt karne ki key. Khaali chhodenge to pehli baar secret.key file ban jayegi.
SESSION_SECRET=
